{
  "name": "@schoolos/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Typed SchoolOS API client. Types are generated from apps/api/openapi.json (openapi-typescript); runtime is openapi-fetch.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "node ./scripts/generate.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
