<!--
  SchoolOS Tally agent as a Windows service (ADR-0032 §7, D69), with WinSW (MIT licence,
  https://github.com/winsw/winsw; the version and SHA-256 are pinned in ..\installer\pins.toml).
  The MSI (..\installer\) installs WinSW as sos-tally-agent.exe next to this file, with the
  agent's Python runtime in .\python, and registers the service itself:

    - account: the virtual account NT SERVICE\SchoolOSTallyAgent (no password, no sign-in,
      never LocalSystem), so the DPAPI-protected device key is readable by that account only;
    - start: automatic (delayed); on failure: restart after 60 seconds (reset after a day).

  Do not run `sos-tally-agent.exe install` on an MSI install (it would register the service a
  second time under another account). The service id below must stay SchoolOSTallyAgent (the
  MSI's service name and the virtual account's name).

  State (configuration, device key, logs) lives in %ProgramData%\SchoolOS\TallyAgent, whose ACL
  the MSI sets to the service account and Administrators only. Enrol from an elevated prompt
  with tally-agent.cmd (README "Install": the enrol command with its via-service option).
  No double hyphen may appear in this comment: XML forbids it and WinSW would not start.

  The agent opens no port. It needs outbound HTTPS to the SchoolOS address and Tally's XML
  server on 127.0.0.1 (TallyPrime: Help > Settings > Connectivity > TallyPrime acts as Server,
  port 9000). Block port 9000 for other machines in Windows Defender Firewall.
-->
<service>
  <id>SchoolOSTallyAgent</id>
  <name>SchoolOS Tally agent</name>
  <description>Reads the Tally ledger groups the school chose and sends fee balances to SchoolOS over HTTPS. Opens no port.</description>
  <executable>%BASE%\python\python.exe</executable>
  <!-- -I: isolated mode (no PYTHON* variables, no user site-packages, no current directory). -->
  <arguments>-I -m sos_edge_agent.cli --state-dir "%ProgramData%\SchoolOS\TallyAgent" run</arguments>
  <workingdirectory>%ProgramData%\SchoolOS\TallyAgent</workingdirectory>
  <stopparentprocessfirst>true</stopparentprocessfirst>
  <stoptimeout>30 sec</stoptimeout>
  <logpath>%ProgramData%\SchoolOS\TallyAgent\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>1024</sizeThreshold>
    <keepFiles>5</keepFiles>
  </log>
</service>
