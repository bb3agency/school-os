{
  "interactiveLogin": true,
  "httpServer": "NettyWrapper",
  "tokenCallbacks": [
    {
      "issuerId": "schoolos",
      "tokenExpiry": 600,
      "requestMappings": [
        {
          "requestParam": "client_id",
          "match": "*",
          "claims": {
            "aud": ["schoolos-web"],
            "amr": ["pwd", "mfa"],
            "sos:mfa": "true"
          }
        }
      ]
    },
    {
      "issuerId": "platform",
      "tokenExpiry": 600,
      "requestMappings": [
        {
          "requestParam": "client_id",
          "match": "schoolos-support",
          "claims": {
            "aud": ["schoolos-support"],
            "client_id": "schoolos-support",
            "token_use": "access",
            "amr": ["pwd", "mfa"],
            "sos:mfa": "true"
          }
        },
        {
          "requestParam": "client_id",
          "match": "*",
          "claims": {
            "aud": ["schoolos-platform"],
            "amr": ["pwd", "mfa"],
            "sos:mfa": "true"
          }
        }
      ]
    }
  ]
}
