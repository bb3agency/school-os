# Copy to terraform.tfvars and fill in. Staging holds SYNTHETIC data only (make seed-synthetic).
aws_account_id = "<STAGING_ACCOUNT_ID>"
owner          = "<owner email or team>"
cost_center    = "<cost centre>"

release_version = "2026.10.1"

app_domain            = "app.staging.<your-domain>"
admin_domain          = "admin.staging.<your-domain>"
route53_zone_id       = null
cognito_domain_prefix = "<globally-unique-prefix>-staging"

# Invoice supplier: STAGING ONLY, synthetic and NOT valid for tax invoices. It only needs to differ
# from the dev placeholder, which the app refuses in staging/prod. Prod uses the registered values.
billing_supplier_legal_name = "SchoolOS Staging Synthetic Supplier (not a tax invoice)"
billing_supplier_gstin      = "37STAGE0000S1Z5"
billing_supplier_state_code = "37"
billing_supplier_address    = "Synthetic staging supplier (not a tax invoice); Vijayawada 520001, Andhra Pradesh"
# platform_invoice_bucket   = null # optional separate invoice-PDF bucket (docs/16 §5.8)

# Staff invitation email via SES (US-102; docs/10 §5.2). 1) set email_domain and apply, 2) publish the
# DKIM CNAMEs (terraform output ses) unless email_route53_zone_id manages them, 3) request SES
# production access, 4) set email_from and email_provider = "ses" and apply.
email_provider = "off"
# email_domain          = "mail.<your-domain>"
# email_route53_zone_id = null
# email_from            = "SchoolOS <no-reply@mail.<your-domain>>"

# Claude safety lock (docs/10 §11): leave false unless a models.yaml role uses provider anthropic
# AND the Anthropic Zero Data Retention agreement and DPA are signed.
# anthropic_zdr_confirmed = false

# Public marketing pages (docs/17 §5.6; not secrets). Empty or unset = that part is hidden.
# public_contact_email   = "hello@<your-domain>"
# public_company_name    = "<legal or trading name>"
# public_company_address = "<line 1>|<line 2>|<city PIN>"
# public_whatsapp_number = "+91<10-digit number>"

alarm_emails       = ["<dev-alerts@your-domain>"]
# SEC-023 baseline in the staging account (on by default; 180-day GOVERNANCE-locked CloudTrail).
# enable_security_baseline = true
# security_alert_emails    = ["<dev-alerts@your-domain>"]
monthly_budget_usd = 120

state_bucket_arn  = "arn:aws:s3:::sos-tfstate-<STAGING_ACCOUNT_ID>"
state_kms_key_arn = "arn:aws:kms:ap-south-1:<STAGING_ACCOUNT_ID>:key/<STATE_KEY_ID>"
