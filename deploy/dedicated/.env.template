# SchoolOS dedicated host: environment reference. NO SECRETS IN THIS FILE OR IN GIT.
#
# On a real host nothing is edited by hand:
#   /etc/schoolos/host.env     non-secret config rendered by Terraform (cloud-init), listed below
#   /etc/schoolos/version.env  SOS_VERSION of the active release (written by bootstrap/upgrade)
#   <release>/release.env      image references pinned by digest (written by CI, scripts/package.sh)
#   /etc/schoolos/secrets.env  0600 root, written by scripts/fetch-secrets.sh from AWS Secrets Manager
#   /etc/schoolos/compose.env  0600 root, the concatenation used by scripts/compose.sh
#
# To inspect or refresh secrets: sudo <install dir>/scripts/fetch-secrets.sh

# --- host.env (from Terraform) ---------------------------------------------------------------
SCHOOL_CODE=demo-school
SOS_ENV=prod
SOS_DEPLOYMENT_MODE=dedicated
SOS_DEPLOYMENT_ID=00000000-0000-0000-0000-000000000000
SOS_DEDICATED_TENANT_ID=00000000-0000-0000-0000-000000000000
AWS_REGION=ap-south-1
AWS_DEFAULT_REGION=ap-south-1
SOS_BACKUP_REGION=ap-south-2
SOS_PUBLIC_HOST=demo-school.example.test
SOS_CUSTOM_DOMAIN=
SOS_ACME_EMAIL=ops@example.test
SOS_ECR_REGISTRY=111122223333.dkr.ecr.ap-south-1.amazonaws.com
# The web container's FILES_ORIGIN (CSP for presigned uploads/previews) is derived in compose.yaml as
# https://$SOS_S3_BUCKET_FILES.s3.$AWS_REGION.amazonaws.com; the bucket's CORS rule (Terraform) lets
# https://$SOS_PUBLIC_HOST and https://$SOS_CUSTOM_DOMAIN POST there. Nothing to set by hand.
SOS_S3_BUCKET_FILES=sos-ded-demo-school-files-111122223333
SOS_S3_BUCKET_AUDIT=sos-ded-demo-school-audit-111122223333
SOS_BACKUP_BUCKET=sos-ded-demo-school-backup-111122223333
SOS_BACKUP_KMS_KEY_ARN=arn:aws:kms:ap-south-2:111122223333:key/00000000-0000-0000-0000-000000000000
SOS_KMS_DATA_KEY_ARN=arn:aws:kms:ap-south-1:111122223333:key/00000000-0000-0000-0000-000000000000
SOS_AUDIT_SIGNING_KEY_ARN=arn:aws:kms:ap-south-1:111122223333:key/00000000-0000-0000-0000-000000000001
SOS_KEY_WRAPPER=kms
SOS_LOG_GROUP=/schoolos/dedicated/demo-school
SOS_DATA_VOLUME_ID=vol-00000000000000000
SOS_SECRET_JSON_IDS="arn:aws:secretsmanager:...:secret:sos/dedicated/demo-school/generated arn:aws:secretsmanager:...:secret:sos/dedicated/demo-school/operator"
SOS_SECRET_PLAIN="OIDC_CLIENT_SECRET=arn:aws:secretsmanager:...:secret:sos/dedicated/demo-school/oidc/tenant-client-secret"
SOS_OIDC_ISSUER=https://cognito-idp.ap-south-1.amazonaws.com/ap-south-1_EXAMPLE
SOS_OIDC_AUDIENCE=exampleclientid
OIDC_CLIENT_ID=exampleclientid
# Break-glass support sign-in (ADR-0023): the host's own support app client in the prod OPERATOR pool
# (Terraform operator_user_pool_id). All three empty = off; SOS_SECRET_PLAIN then has no
# SUPPORT_OIDC_CLIENT_SECRET entry.
SOS_SUPPORT_OIDC_ISSUER=
SOS_SUPPORT_OIDC_AUDIENCE=
SUPPORT_OIDC_CLIENT_ID=
SOS_CONTROL_PLANE_URL=https://app.example.test
SOS_INSTALL_DIR=/opt/schoolos/deploy/dedicated
SOS_BUNDLE_S3_PREFIX=s3://sos-prod-artifacts-111122223333/dedicated
SOS_BUNDLE_SHA256=
SOS_WALG_ENABLED=false
# AI (ADR-0033; docs/10 §11.1), only once the school has AI and the Vertex project is set up for
# Zero Data Retention: add to host.env by hand SOS_LLM_GCP_PROJECT=<project>,
# SOS_LLM_GCP_CREDENTIALS_SOURCE=workload-identity and SOS_LLM_ZDR_CONFIRMED=true, and put the
# credential JSON in the operator secret under the key SOS_LLM_GCP_CREDENTIALS_JSON. Unset = off.
# Claude safety lock (docs/10 §11): while any models.yaml role uses provider anthropic the api and
# workers refuse to start unless host.env has SOS_ANTHROPIC_ZDR_CONFIRMED=true, which may be added
# only once the Anthropic Zero Data Retention agreement and DPA are signed. Unset = false.

# --- version.env / release.env ---------------------------------------------------------------
SOS_VERSION=2026.10.1
SOS_API_IMAGE=schoolos/api:2026.10.1
SOS_WEB_IMAGE=schoolos/web:2026.10.1
SOS_WORKER_IMAGE=schoolos/worker:2026.10.1

# --- secrets.env keys (values come from Secrets Manager; never write them here) ----------------
# generated secret:  POSTGRES_PASSWORD SOS_APP_DB_PASSWORD SOS_MIGRATOR_DB_PASSWORD SOS_PLATFORM_DB_PASSWORD
#                    SOS_READONLY_DB_PASSWORD VALKEY_PASSWORD SOS_SERVICE_TOKEN_KEY SESSION_SECRET
# operator secret:   SOS_ANTHROPIC_API_KEY SOS_HEARTBEAT_KEY_ID SOS_HEARTBEAT_KEY
#                    (heartbeat key ID + key: shown once by the panel at provisioning / rotation)
# plain secret:      OIDC_CLIENT_SECRET
#                    SUPPORT_OIDC_CLIENT_SECRET (only when the support client is configured)

# --- optional tuning (defaults suit t3.medium, 4 GiB) -----------------------------------------
# SOS_MEM_DB=1536m SOS_MEM_API=768m SOS_MEM_WORKER=1280m SOS_MEM_WEB=512m
# SOS_PG_SHARED_BUFFERS=512MB SOS_VALKEY_MAXMEMORY=192mb SOS_WORKER_CONCURRENCY=2
# SOS_WALG_RETAIN_FULL=14 SOS_LOG_LEVEL=INFO
