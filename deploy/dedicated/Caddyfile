# SchoolOS dedicated host edge (TB1). Automatic HTTPS (ACME) for the platform host name and the
# school's optional custom domain; HTTP only redirects. Only the web/BFF is proxied: the API is reachable
# solely on the internal container network, and fleet/metrics paths are never exposed here.
{
	email {$SOS_ACME_EMAIL}
	# Admin API stays inside the container (healthcheck only; the port is not published).
	admin 127.0.0.1:2019
	servers {
		protocols h1 h2 h3
		# Caddy is the first hop: no trusted_proxies, so a client's own X-Forwarded-For is never
		# believed (a client reached through Docker's userland proxy has a private address). Caddy
		# sets X-Forwarded-For itself; the BFF reads one hop (TRUSTED_PROXY_HOPS=1).
		# Explicit timeouts: slow-header clients are dropped after 10 s; bodies (25 MB max, slow
		# office links) get 5 min; idle keep-alive 2 min. No write timeout: it would cut streamed AI
		# answers (SSE); the proxy's response_header_timeout bounds a silent upstream.
		timeouts {
			read_header 10s
			read_body 5m
			idle 2m
		}
	}
}

(security_headers) {
	# HSTS: includeSubDomains + preload only on our own platform host name. A school's custom
	# domain may be its apex: preloading it would force HTTPS on every subdomain of the school's
	# domain for two years, which is the school's decision, not ours.
	@platform_host host {$SOS_PUBLIC_HOST}
	@custom_domain not host {$SOS_PUBLIC_HOST}
	header @platform_host Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
	header @custom_domain Strict-Transport-Security "max-age=63072000"
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		X-Frame-Options "DENY"
		-Server
		-X-Powered-By
		# Content-Security-Policy is set by the web app (per-request nonce, 07 §11).
	}
}

{$SOS_PUBLIC_HOST} {$SOS_CUSTOM_DOMAIN} {
	import security_headers
	encode zstd gzip

	# Never exposed on a school host: control-plane fleet API and metrics.
	@internal path /api/v1/fleet /api/v1/fleet/* /metrics /metrics/*
	respond @internal "Not found" 404

	request_body {
		max_size 25MB
	}

	reverse_proxy web:3000 {
		health_uri /healthz
		health_interval 15s
		header_up -X-Service-Token
		transport http {
			dial_timeout 5s
			response_header_timeout 120s
		}
	}

	log {
		output stdout
		format filter {
			wrap json
			fields {
				# OIDC callback parameters are credentials; never log them.
				# Personal data must never be sent in a query string (docs/09 §1, docs/13): searches
				# use POST .../search with a JSON body. Defense in depth for clients still using the
				# deprecated GET /api/v1/students?query=&admission_no= and for common PII names
				# (SEC-008, invariant 5).
				request>uri query {
					replace code REDACTED
					replace state REDACTED
					replace query REDACTED
					replace q REDACTED
					replace admission_no REDACTED
					replace name REDACTED
					replace phone REDACTED
					replace email REDACTED
					replace dob REDACTED
					replace address REDACTED
				}
				request>headers>Authorization delete
				request>headers>Cookie delete
				resp_headers>Set-Cookie delete
			}
		}
	}
}
