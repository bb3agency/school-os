# import-linter contracts for the API package (CLAUDE.md §4 module boundaries).
#
# Run from the repo root with the uv environment (sos-api is an editable workspace member,
# so `app` is importable):   uv run lint-imports --config .importlinter
#
# Rules expressed here:
#   1. Modules talk to each other only through `service.py`: nobody outside module Y may
#      import app.Y.repository or app.Y.models. core, authz and audit are shared building
#      blocks that everyone may import, so they get no such contract.
#   2. core is the bottom layer: it must not import any feature module.
#   3. Tenant-side modules must not import the control plane (app.platform); a dedicated host
#      runs with the platform routes disabled (CONTRACT §1).
#
# Indirect imports are allowed in (1): app.tenancy.service -> app.identity.service ->
# app.identity.repository is the intended shape. Only direct imports are violations.
#
# import-linter fails on modules that do not exist, so only modules that exist today are
# listed. When a new module lands, add it to every `source_modules` list below and add its
# own "<module>-internals" contract.
# knowledge (M2) has its own section at the end: internals, layers, gateway isolation,
# read-only tools and pure foundations. Third-party provider SDK imports are covered by the
# semgrep rule `sos-llm-sdk-outside-gateway` (only apps/api/app/knowledge/gateway/ may import
# them), because import-linter cannot forbid a package that is not installed.

[importlinter]
root_package = app
# External packages are graph nodes so a contract can forbid e.g. sqlalchemy (dq-pure-library).
include_external_packages = True

# --- 1. module internals are private -------------------------------------------------------

[importlinter:contract:identity-internals]
name = identity: repository/models are private (use app.identity.service)
type = forbidden
source_modules =
    app.main
    app.core
    app.audit
    app.authz
    app.tenancy
    app.platform
    app.ops
    app.devtools
    app.dq
    app.students
    app.documents
    app.notifications
    app.breakglass
    app.imports
    app.changes
    app.extraction
    app.exports
    app.knowledge
    app.admin
    app.circulars
    app.certificates
forbidden_modules =
    app.identity.repository
    app.identity.models
allow_indirect_imports = True

[importlinter:contract:tenancy-internals]
name = tenancy: repository/models are private (use app.tenancy.service)
type = forbidden
source_modules =
    app.main
    app.core
    app.audit
    app.authz
    app.identity
    app.platform
    app.ops
    app.devtools
    app.dq
    app.students
    app.documents
    app.notifications
    app.breakglass
    app.imports
    app.changes
    app.extraction
    app.exports
    app.knowledge
    app.admin
    app.circulars
    app.certificates
forbidden_modules =
    app.tenancy.repository
    app.tenancy.models
allow_indirect_imports = True

[importlinter:contract:platform-internals]
name = platform: repository/models are private (use app.platform.service)
type = forbidden
source_modules =
    app.main
    app.core
    app.audit
    app.authz
    app.identity
    app.tenancy
    app.ops
    app.devtools
    app.dq
    app.students
    app.documents
    app.notifications
    app.breakglass
    app.imports
    app.changes
    app.extraction
    app.exports
    app.knowledge
    app.admin
    app.circulars
    app.certificates
forbidden_modules =
    app.platform.repository
    app.platform.models
allow_indirect_imports = True

# --- 2. core is the base layer -------------------------------------------------------------

[importlinter:contract:core-is-base]
name = core must not import feature modules
type = forbidden
source_modules =
    app.core
forbidden_modules =
    app.audit
    app.authz
    app.identity
    app.tenancy
    app.platform
    app.ops
    app.devtools
    app.dq
    app.students
    app.documents
    app.notifications
    app.breakglass
    app.imports
    app.changes
    app.extraction
    app.exports
    app.knowledge
    app.admin
    app.circulars
    app.certificates

# The HTML -> PDF renderer (headless Chromium, bundled font, sandbox setting) is app.core.pdf,
# a neutral building block. The control plane prints its invoices through it and never through
# the exports module (school data; ADR-0020, CLAUDE.md §4).
[importlinter:contract:platform-pdf-via-core]
name = platform prints PDFs only through app.core.pdf (never app.exports)
type = forbidden
source_modules =
    app.platform
forbidden_modules =
    app.exports

# --- 3. tenant side never depends on the control plane ------------------------------------

[importlinter:contract:tenant-side-without-control-plane]
name = tenant-side modules must not import the control plane (app.platform)
type = forbidden
# app.breakglass is deliberately absent: it is the sanctioned bridge that pulls operator
# requests through app.platform.service (US-103), like app.platform.tenant_api.
source_modules =
