# --- 4. knowledge (M2; docs/06, ADR-0005, ADR-0008) ----------------------------------------
# Other modules use only app.knowledge.service (and, later, the api/tasks entry points that
# app.main and the worker load). Every subpackage and internal module below is private.

[importlinter:contract:knowledge-internals]
name = knowledge: subpackages and internals are private (use app.knowledge.service)
type = forbidden
source_modules =
    app.main
    app.core
    app.audit
    app.authz
    app.identity
    app.tenancy
    app.platform
    app.ops
    app.devtools
    app.dq
    app.students
    app.documents
    app.notifications
    app.breakglass
    app.imports
    app.changes
    app.extraction
    app.exports
    app.admin
    app.circulars
    app.certificates
forbidden_modules =
    app.knowledge.gateway
    app.knowledge.embeddings
    app.knowledge.retrieval
    app.knowledge.ingestion
    app.knowledge.chunking
    app.knowledge.tools
    app.knowledge.prompts
    app.knowledge.config
    app.knowledge.interfaces
    app.knowledge.domain
    app.knowledge.sources
    app.knowledge.repository
    app.knowledge.models
    app.knowledge.circulars
    app.knowledge.circular_ai
allow_indirect_imports = True

# Top to bottom: a package may import only packages below it. Consequences that matter:
# retrieval, tools, embeddings and chunking cannot reach the gateway (no model calls from
# ranking, record tools or chunking); nothing below ingestion can write the index; the
# pure foundations (prompts, config, interfaces, sources, domain) import no knowledge package.
# Implementations are wired together in service (composition root).
[importlinter:contract:knowledge-layers]
name = knowledge packages are layered (retrieval/tools/embeddings/chunking never reach the gateway)
type = layers
containers =
    app.knowledge
layers =
    service
    ingestion
    gateway
    tools
    retrieval
    embeddings
    chunking
    prompts
    config
    interfaces
    sources
    domain

# The gateway sends to a provider exactly what its caller hands it: it never reads records,
# documents or the index itself, so the model cannot receive data the user cannot see
# (invariant 8). Indirect imports (e.g. through app.audit) are allowed.
[importlinter:contract:knowledge-gateway-isolated]
name = knowledge.gateway reads no records, documents or index (callers pass allowed blocks)
type = forbidden
source_modules =
    app.knowledge.gateway
forbidden_modules =
    app.knowledge.service
    app.knowledge.ingestion
    app.knowledge.tools
    app.knowledge.retrieval
    app.knowledge.embeddings
    app.knowledge.chunking
    app.identity
    app.tenancy
    app.platform
    app.devtools
    app.dq
    app.students
    app.documents
    app.notifications
    app.breakglass
    app.imports
    app.changes
    app.extraction
    app.exports
    app.admin
    app.circulars
    app.certificates
allow_indirect_imports = True

# Record tools are read-only and have no network (invariant 9, ADR-0008, SEC-020): no model
# calls, no ingestion writes, no HTTP/S3 clients, no task enqueueing. Indirect imports through
# other modules' services (which use S3 or Celery themselves) are allowed.
[importlinter:contract:knowledge-tools-read-only]
name = knowledge.tools are read-only (no gateway, ingestion, network or task queue)
type = forbidden
source_modules =
    app.knowledge.tools
forbidden_modules =
    app.knowledge.service
    app.knowledge.gateway
    app.knowledge.ingestion
    httpx
    boto3
    celery
allow_indirect_imports = True

# Chunking, prompts, config and the value types stay pure (no database, web, network or
# feature module), so they run anywhere and test without a database. Indirect imports count.
[importlinter:contract:knowledge-pure-foundations]
name = knowledge chunking/prompts/config/domain/sources stay pure (only app.core helpers)
type = forbidden
source_modules =
    app.knowledge.chunking
    app.knowledge.prompts
    app.knowledge.config
    app.knowledge.domain
    app.knowledge.sources
    app.knowledge.circulars
forbidden_modules =
    sqlalchemy
    fastapi
    celery
    httpx
    boto3
    app.core.db
    app.audit
    app.authz
    app.identity
    app.tenancy
    app.platform
    app.ops
    app.devtools
    app.dq
    app.students
    app.documents
    app.notifications
    app.breakglass
    app.imports
    app.changes
    app.extraction
    app.exports
    app.knowledge.service
    app.knowledge.ingestion
    app.knowledge.gateway
    app.knowledge.tools
    app.knowledge.retrieval
    app.knowledge.embeddings
    app.knowledge.interfaces
    app.admin
    app.circulars
    app.certificates

