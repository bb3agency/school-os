# The admin module reads every module through its service (docs/04 §3: "all services (read)"),
# so no other module may depend on it: retention jobs read the school's setting through
# app.core.retention, where app.admin registers its provider (FR-ADM-002).
[importlinter:contract:admin-is-a-leaf]
name = nothing imports app.admin except the app entry point and the worker
type = forbidden
source_modules =
    app.core
    app.audit
    app.authz
    app.identity
    app.tenancy
    app.platform
    app.ops
    app.devtools
    app.dq
    app.students
