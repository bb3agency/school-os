# The name-matching library, rule types, explanation catalog, checks, masking and profiles stay
# pure (no database, web or tenant modules), so the engine, imports and exports can reuse them
# anywhere (FR-DQ-003). The engine, service, repository, tasks and routes use the database.
[importlinter:contract:dq-pure-library]
name = dq library modules (matching, rules, explanations, checks, masking, profiles) stay pure
type = forbidden
source_modules =
    app.dq.matching
    app.dq.rules
    app.dq.explanations
    app.dq.checks
    app.dq.masking
    app.dq.profiles
forbidden_modules =
    sqlalchemy
    fastapi
    app.core.db
    app.audit
    app.authz
    app.identity
    app.tenancy
    app.platform
    app.ops

[importlinter:contract:imports-internals]
name = imports: repository/models are private (use app.imports.service)
type = forbidden
source_modules =
    app.main
    app.core
    app.audit
    app.authz
    app.identity
    app.tenancy
    app.platform
    app.ops
    app.devtools
    app.dq
    app.students
    app.documents
    app.notifications
    app.breakglass
    app.changes
    app.extraction
    app.exports
    app.knowledge
forbidden_modules =
    app.imports.repository
    app.imports.models
allow_indirect_imports = True

# Spreadsheet reading, mapping suggestions, value conversion and row validation stay pure (no
# database or web), so 2,000 rows validate without a round trip per row (NFR-PERF-004).
[importlinter:contract:imports-pure-library]
name = imports parsing/mapping/validation modules stay pure (no DB, web or feature modules)
type = forbidden
source_modules =
    app.imports.sheet
    app.imports.mapping
    app.imports.values
    app.imports.validation
    app.imports.config
forbidden_modules =
