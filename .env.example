# SchoolOS local environment. Copy to .env (never commit .env).
# Every value here is a DEV-ONLY placeholder. Staging/production secrets come from
# AWS Secrets Manager; the API refuses to start in staging/prod with "dev-only" values.
#
# Every API/worker setting (apps/api/app/core/config.py) is listed, grouped as in
# docs/10 §11. Commented-out lines show the default: uncomment one only to change it.
# An empty commented value means "unset". apps/api/tests/deploy/test_env_example.py fails
# when a setting is missing here or a commented value is not its default.

# --- Runtime ------------------------------------------------------------------------------
# local | ci | staging | prod (staging/prod: production guards on, API docs off).
SOS_ENV=local
# shared | dedicated (dedicated removes control-plane routes and schedules). Also read by web.
SOS_DEPLOYMENT_MODE=shared
SOS_LOG_LEVEL=INFO
# Telemetry identity: service name and release version in logs and traces.
# SOS_SERVICE_NAME=api
# SOS_VERSION=0.0.0-dev

# --- Database -----------------------------------------------------------------------------
# Postgres roles (see infra/db/bootstrap.sql). Used by docker compose to build URLs.
SOS_DB_ADMIN_PASSWORD=dev-only-admin
SOS_DB_APP_PASSWORD=dev-only-app
SOS_DB_MIGRATOR_PASSWORD=dev-only-migrator
SOS_DB_PLATFORM_PASSWORD=dev-only-platform
SOS_DB_READONLY_PASSWORD=dev-only-readonly
# Host ports for Postgres and Valkey (change when another project already uses them).
SOS_DB_PORT=5432
SOS_VALKEY_PORT=6379
# Connection URLs. docker compose and scripts/dev.py build them from the passwords above.
# Tenant role (sos_app, RLS applies):
# SOS_DATABASE_URL=postgresql+psycopg://sos_app:dev-only-app@localhost:5432/schoolos
# Control-plane role (sos_platform, schema platform only):
# SOS_PLATFORM_DATABASE_URL=postgresql+psycopg://sos_platform:dev-only-platform@localhost:5432/schoolos
# Alembic and the audit partition CLI (sos_migrator):
# SOS_MIGRATOR_DATABASE_URL=postgresql+psycopg://sos_migrator:dev-only-migrator@localhost:5432/schoolos
# Connection pool size per engine.
# SOS_DB_POOL_SIZE=10
# Transaction-local statement timeouts: requests, and long worker jobs.
# SOS_DB_STATEMENT_TIMEOUT_MS=5000
# SOS_WORKER_STATEMENT_TIMEOUT_MS=120000

# --- Valkey (Celery broker, rate limits, caches) ------------------------------------------
# SOS_REDIS_URL=redis://localhost:6379/0

# --- Object storage (SeaweedFS locally, S3 in AWS) ----------------------------------------
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=dev-only-access-key
AWS_SECRET_ACCESS_KEY=dev-only-secret-key
SOS_S3_BUCKET_FILES=sos-local-files
SOS_S3_BUCKET_AUDIT=sos-local-audit-archive
# S3 endpoint for SeaweedFS (compose and scripts/dev.py set it); unset in staging/prod.
# SOS_S3_ENDPOINT_URL=
# Endpoint used only to sign browser-facing presigned URLs (locally http://localhost:8333).
# SOS_S3_PRESIGN_ENDPOINT_URL=
# KMS key for SSE-KMS on uploaded files (FR-DOC-003); unset locally (SeaweedFS).
# SOS_S3_KMS_KEY_ID=

# --- Documents and uploads (FR-DOC-001..004, SEC-016) -------------------------------------
# Largest document / spreadsheet-import upload in bytes (25 MiB, 10 MiB; at most 100 MiB).
# SOS_DOCUMENTS_MAX_UPLOAD_BYTES=26214400
# SOS_DOCUMENTS_IMPORT_MAX_UPLOAD_BYTES=10485760
# Presigned POST and GET lifetimes in seconds (at most 600 and 300).
# SOS_DOCUMENTS_UPLOAD_URL_TTL_S=600
# SOS_DOCUMENTS_DOWNLOAD_URL_TTL_S=300
# File kinds accepted by content sniffing, never by extension (a JSON list).
# SOS_DOCUMENTS_ALLOWED_KINDS=["pdf","jpg","png","docx","xlsx"]
# SOS_DOCUMENTS_IMPORT_ALLOWED_KINDS=["xlsx","csv"]
# Malware scanner: clamav | dev-noop (dev-noop refuses to run in staging/prod).
# SOS_AV_SCANNER=dev-noop
# clamd connection when SOS_AV_SCANNER=clamav.
# SOS_CLAMAV_HOST=localhost
# SOS_CLAMAV_PORT=3310
# SOS_CLAMAV_TIMEOUT_S=30.0

# --- Register-photo extraction (US-402, FR-IMP-020..024) ----------------------------------
# fake | not-configured. Unset: fake in local/ci, not-configured in staging/prod.
# SOS_EXTRACTION_PROVIDER=
# Fields read below this confidence are highlighted for the reviewer.
# SOS_EXTRACTION_LOW_CONFIDENCE_THRESHOLD=0.8

# --- Knowledge / Ask the school (M2; docs/06, ADR-0005, ADR-0006, ADR-0033) -----------------
# Master switch; a school also needs the feature flag kb.ask.enabled. Providers, model IDs,
# budgets and thresholds are versioned files (apps/api/app/knowledge/config/), not settings.
# SOS_KB_ENABLED=false
# English first (ADR-0036): Telugu is hidden unless true (API, worker and web).
# SOS_TELUGU_ENABLED=false
# fake | live. Unset: fake (offline, deterministic) in local/ci, live in staging/prod (fake is
# refused there). live calls real providers and needs the credentials below.
# SOS_KB_PROVIDER_MODE=
# Google Gemini on Vertex AI (ADR-0033, the default LLM provider). Project and location (India
# only in staging/prod: asia-south1 or asia-south2). Credentials: a service identity, never a
# person's gcloud login: workload-identity (AWS -> Google federation config JSON, no secret) or
# service-account-key (key JSON from Secrets Manager). Never commit a real key.
# SOS_LLM_GCP_PROJECT=
# SOS_LLM_GCP_LOCATION=asia-south1
# SOS_LLM_GCP_CREDENTIALS_SOURCE=
# SOS_LLM_GCP_CREDENTIALS_JSON=
# true only after the Vertex project's Zero Data Retention steps (docs/10 §11) are done.
# SOS_LLM_ZDR_CONFIRMED=false
# Read the project's cacheConfig before the first call and refuse unless caching is off.
# SOS_LLM_VERIFY_CACHE_CONFIG=true
# Organization API keys only, never a personal AI subscription. Never commit a real key.
# Anthropic is the config-selectable fallback: needed only while a role uses provider anthropic.
# SOS_ANTHROPIC_API_KEY=
# SOS_EMBEDDINGS_API_KEY=
# Contextual retrieval and reranking (docs/06 §4.11, §6), per environment. Unset: the value in
# apps/api/app/knowledge/config/retrieval.yaml (both off). off | on
# SOS_KB_CONTEXTUAL_CHUNKS=
# off | voyage | vertex (fake mode runs the offline reranker; voyage reuses the embeddings key)
# SOS_KB_RERANK=

# --- Identity -----------------------------------------------------------------------------
# Dev OIDC stub in the "dev" compose profile. oidc.localhost resolves to 127.0.0.1 in
# browsers (RFC 6761) and to the oidc container inside compose (network alias), so the
# browser, the web container and the API all see the same issuer. Running the web app or
# API on the host instead? Use http://localhost:8080/... for all four issuer variables.
SOS_OIDC_ISSUER=http://oidc.localhost:8080/schoolos
SOS_OIDC_AUDIENCE=schoolos-web
SOS_PLATFORM_OIDC_ISSUER=http://oidc.localhost:8080/platform
SOS_PLATFORM_OIDC_AUDIENCE=schoolos-platform
# Explicit JWKS URLs (skip discovery); compose points them at http://oidc:8080/...
# SOS_OIDC_JWKS_URI=
# SOS_PLATFORM_OIDC_JWKS_URI=
# Break-glass support sign-in (ADR-0023): the support app client of the OPERATOR pool. Unset
# audience = off (support access cannot be used). Issuer defaults to SOS_PLATFORM_OIDC_ISSUER;
# the JWKS URL to SOS_PLATFORM_OIDC_JWKS_URI when the issuers match.
SOS_SUPPORT_OIDC_AUDIENCE=schoolos-support
# SOS_SUPPORT_OIDC_ISSUER=
# SOS_SUPPORT_OIDC_JWKS_URI=
# HS256 key for the BFF's X-Service-Token (same value in the web app).
SOS_SERVICE_TOKEN_KEY=dev-only-service-token-key-change-me-0123456789

# --- Key management and audit archives ----------------------------------------------------
# local-dev wrapper only works when SOS_ENV is local or ci; kms in staging/prod.
SOS_KEY_WRAPPER=local-dev
SOS_LOCAL_DEV_MASTER_KEY=dev-only-master-key-base64-placeholder
# KMS key that wraps tenant DEKs and heartbeat keys (SOS_KEY_WRAPPER=kms).
# SOS_KMS_DATA_KEY_ARN=
# Asymmetric KMS key (ECC_NIST_P256) signing daily audit archives.
# SOS_AUDIT_SIGNING_KEY_ARN=
# Object Lock retention for audit archives, in days.
# SOS_AUDIT_ARCHIVE_RETENTION_DAYS=1096

# --- Telemetry (optional) -----------------------------------------------------------------
SOS_OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Email (optional; staff invitation emails) ----------------------------------------------
# off (default) | fake (in memory, local/ci only) | ses (Amazon SES v2 in AWS_REGION).
# SOS_EMAIL_PROVIDER=off
# Required when email is on: verified sender and the web app address used in links.
# (e.g. "SchoolOS <no-reply@schoolos.localhost>" and http://localhost:3000 locally)
# SOS_EMAIL_FROM=
# SOS_EMAIL_APP_URL=
# SOS_EMAIL_SES_CONFIGURATION_SET=

# --- Control plane and fleet (docs/16 §10, §12; ADR-0015) ---------------------------------
# Supplier block on GST invoices (these dev placeholders are refused in staging/prod).
# SOS_BILLING_SUPPLIER_LEGAL_NAME=SchoolOS Synthetic Supplier (dev)
# SOS_BILLING_SUPPLIER_GSTIN=37AAAAA0000A1Z5
# SOS_BILLING_SUPPLIER_STATE_CODE=37
# Registered address on invoice PDFs (the dev placeholder refuses to render in staging/prod).
# SOS_BILLING_SUPPLIER_ADDRESS=Synthetic supplier address (dev); Vijayawada 520001, Andhra Pradesh
# Control-plane bucket for invoice PDFs; empty = the files bucket under platform/invoices/.
# SOS_PLATFORM_INVOICE_BUCKET=
# Dedicated hosts only: where the heartbeat is sent, the host's identity, and its HMAC key
# (base64url, shown once by the panel).
# SOS_CONTROL_PLANE_URL=
# SOS_DEPLOYMENT_ID=
# SOS_DEDICATED_TENANT_ID=
# SOS_HEARTBEAT_KEY_ID=
# SOS_HEARTBEAT_KEY=

# --- Web (Next.js BFF) --------------------------------------------------------------------
APP_BASE_URL=http://localhost:3000
# Optional origin of the file store: presigned previews and uploads (CSP img-src + connect-src).
# https only; under `next dev` a loopback http origin is accepted too (make dev-host sets
# http://localhost:8333 for SeaweedFS).
FILES_ORIGIN=
SESSION_SECRET=dev-only-session-secret-change-me-0123456789abcdef
OIDC_ISSUER=http://oidc.localhost:8080/schoolos
OIDC_CLIENT_ID=schoolos-web
OIDC_CLIENT_SECRET=dev-only-oidc-client-secret
PLATFORM_OIDC_CLIENT_ID=schoolos-platform
PLATFORM_OIDC_CLIENT_SECRET=dev-only-platform-client-secret
# Operators sign in with a separate OIDC issuer/user pool (ADR-0018; MFA always on)
PLATFORM_OIDC_ISSUER=http://oidc.localhost:8080/platform
# Break-glass support sign-in to the school app (ADR-0023): the support app client of the
# operator pool. Leave SUPPORT_OIDC_CLIENT_ID empty to switch it off. SUPPORT_OIDC_ISSUER
# defaults to PLATFORM_OIDC_ISSUER.
SUPPORT_OIDC_CLIENT_ID=schoolos-support
SUPPORT_OIDC_CLIENT_SECRET=dev-only-support-client-secret
# SUPPORT_OIDC_ISSUER=
# Public marketing pages (shared tier only; docs/17 §5.6). Unset = that part of the page is not
# shown (no placeholders). "Talk to us" mailto address, footer/About company name, and an
# optional About-page postal address (`\n` or `|` between lines).
# SOS_PUBLIC_CONTACT_EMAIL=
# SOS_PUBLIC_COMPANY_NAME=
# SOS_PUBLIC_COMPANY_ADDRESS=
# Used by `npm run dev -w @schoolos/web` on the host; docker compose overrides both
# for the web container (API_INTERNAL_URL=http://api:8000, REDIS_URL=redis://valkey:6379/1).
API_INTERNAL_URL=http://localhost:8000
REDIS_URL=redis://localhost:6379/1
# The web BFF signs X-Service-Token with SOS_SERVICE_TOKEN_KEY (above), shared with the API.
