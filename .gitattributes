# Files that run inside Linux containers or hosts keep LF endings on every checkout, including
# Windows with core.autocrlf=true (a CRLF db-init.sh stops Postgres from creating the roles).
* text=auto eol=lf
*.sh text eol=lf
*.bash text eol=lf
*.sql text eol=lf
Dockerfile text eol=lf
Dockerfile.* text eol=lf
Caddyfile text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.conf text eol=lf
Makefile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
